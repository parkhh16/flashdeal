# 서버 환경 비밀값. 이 파일을 .env로 복사해서 채운다 (.env는 git에 올라가지 않는다)
# 임의 값 만들기: openssl rand -base64 32

# MySQL root 비밀번호 (컨테이너 관리용, 앱은 쓰지 않는다)
MYSQL_ROOT_PASSWORD=
# 앱 전용 DB 계정(flashdeal) 비밀번호
DB_PASSWORD=
# JWT 서명 키: Base64, 디코딩해서 32바이트 이상
JWT_SECRET=
# 처음 기동할 때 만들어지는 관리자(admin) 비밀번호. 12자 이상
ADMIN_PASSWORD=

# 도메인이 있으면 shop.example.com 처럼 (인증서 자동 발급, 80/443 포트가 열려 있어야 한다)
# 없으면 localhost(자체 인증서, 브라우저 경고) 또는 :80(HTTP만)
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# API 문서(Swagger UI)를 운영에서도 열지
SWAGGER_ENABLED=false

# 배포 워크플로가 레지스트리(GHCR)에 올린 이미지를 쓸 때만. 서버에서 직접 빌드하면 비워 둔다
IMAGE_PREFIX=
IMAGE_TAG=
